{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agravaaniresearch/nikasha/schema/grid-carbon.schema.json",
  "title": "Grid carbon intensity",
  "type": "object", "required": ["meta", "rows"],
  "properties": {
    "meta": { "type": "object", "required": ["description", "unit", "dataVersion"] },
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "region", "gPerKWh", "basis", "scope", "status", "sources", "lastVerified"],
        "properties": {
          "id": { "type": "string" }, "region": { "type": "string" }, "gPerKWh": { "type": "number", "minimum": 0, "maximum": 2000 },
          "basis": { "type": "string" }, "scope": { "type": "string" },
          "status": { "enum": ["statutory", "secondary", "placeholder", "illustrative"] },
          "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "verification": { "type": "string" }
        }
      }
    }
  }
}
